# Database engine: sqlite or mysql
DB_ENGINE=sqlite

# SQLite configuration
SQLITE_DB_PATH=viajes_aventura.db

# MySQL / WampServer configuration (compatible with MySQL 5.7+ and MariaDB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=viajes_aventura
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
